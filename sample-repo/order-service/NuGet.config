<?xml version="1.0" encoding="utf-8"?>
<!--
  The sample repository restores only from nuget.org. Clearing inherited sources
  keeps `dotnet restore` deterministic for the agent regardless of what private
  feeds the host machine has configured.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
