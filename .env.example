# ---------------------------------------------------------------------------
# Persistence.  PostgreSQL is the target; sqlite+aiosqlite is the no-Docker
# local fallback so the POC runs on a bare laptop (section 36, Mode A).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
# DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# ---------------------------------------------------------------------------
# Coordination.  redis:// for real deployments; memory:// runs an in-process
# queue/event bus/lock manager (single process, dev only).
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=memory://

# ---------------------------------------------------------------------------
# LLM provider.  "anthropic" uses the Claude API; "scripted" is a deterministic
# offline provider used by tests and by demos without an API key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# Source control / CI.  "local" keeps everything on-disk (no network).
# ---------------------------------------------------------------------------
SCM_PROVIDER=local
CI_PROVIDER=none
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# ---------------------------------------------------------------------------
# Workspaces and limits
# ---------------------------------------------------------------------------
WORKSPACE_ROOT=./workspaces
ARTIFACT_ROOT=./artifacts
MAX_AGENT_ITERATIONS=3
MAX_CI_ITERATIONS=2
TASK_LEASE_SECONDS=900
WORKER_CONCURRENCY=2
COMMAND_TIMEOUT_SECONDS=600

LOG_LEVEL=INFO
API_PORT=8000
